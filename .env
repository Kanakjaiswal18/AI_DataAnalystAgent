# Local Ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1

SQL_MODEL= 
INSIGHT_MODEL=

# Neon PostgreSQL
PG_HOST=YOURHOSTNAME
PG_DB=YOURDATABASENAME
PG_USER=YOURUSERNAME
PG_PASSWORD=YOURPASSWORD
PG_SSLMODE=YOURSSLMODE
PG_CHANNELBINDING=YOURCHANNELBINDING

# Agent safety limits
MAX_SQL_RETRIES=2
MAX_ROWS_RETURNED=500
QUERY_TIMEOUT_MS=5000
